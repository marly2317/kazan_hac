# Copy to infra/.env and fill in. `docker compose` reads .env from its own directory.
#
#   cp infra/.env.example infra/.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   # DJANGO_SECRET_KEY

# --- required -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- host and port ------------------------------------------------------------------------
# The port nginx publishes on the host.
PUBLIC_PORT=8080
# Every hostname the app is reached by. Django rejects requests for anything not listed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must include the scheme and the port, and must match how the browser addresses the app, or
# every POST fails CSRF validation.
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- cookies ------------------------------------------------------------------------------
# 0 for the plain-HTTP local stack; set both to 1 as soon as TLS terminates at nginx.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# --- database -----------------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app

# --- подбор КТРУ: языковая модель (apps/ste) ------------------------------------------------
# Правила хакатона ЗАПРЕЩАЮТ внешние API проприетарных LLM (OpenAI GPT, Google Gemini,
# Anthropic Claude и подобные) и разрешают только ОТКРЫТЫЕ модели (суммарно ≤ 40 ГБ VRAM) —
# напрямую или через роутер (timeweb, selectel, OpenRouter). Gemma 4 — открытые веса.
#
# Любая OpenAI-совместимая точка входа:
#   STE_LLM_BASE_URL=https://openrouter.ai/api/v1      # роутер
#   STE_LLM_BASE_URL=http://ollama:11434/v1            # локальная Ollama
# Ключ пустой — сервис работает правилами (поиск + словари КТРУ), без LLM.
STE_LLM_BASE_URL=https://openrouter.ai/api/v1
STE_LLM_API_KEY=
# Модель: Qwen3.6-35B-A3B (MoE, 3B активных параметров), режим рассуждений выключен в коде
# (reasoning.enabled=false в каждом запросе). Платная: $0,15 / $1 за 1 млн токенов вход/выход.
# LLM работает только на извлечении характеристик (LLM-2) и разборе ответа текстом.
STE_LLM_MODEL=qwen/qwen3.6-35b-a3b
STE_LLM_FALLBACK_MODELS=
STE_LLM_STRUCTURED=prompt
STE_LLM_MIN_INTERVAL=0

# --- подбор КТРУ: поиск и решение ------------------------------------------------------------
# Эмбеддер Qwen3-Embedding-0.6B вшит в образ; 0 — поиск только по BM25.
STE_EMBEDDER_ENABLED=1
# Реранкер Qwen3-Reranker-0.6B (вшит в образ, код сохранён): выключен. 1 — включить
# (на CPU ~2-4 с на карточку, на GPU — доли секунды).
STE_RERANKER_ENABLED=0
STE_RERANK_TOP=15
# LLM-1 — выбор семейства языковой моделью из кандидатов поиска (код сохранён): выключен.
# 0 — семейство по поиску, при неоднозначности вопрос «уточните тип товара».
STE_LLM_FAMILY_SELECT=0
# Для LLM-1: top_k — из топ-30 поиска; full_list — из всех семейств.
STE_FAMILY_SELECT_MODE=top_k
# 1 — однозначный результат поиска принимается без LLM-1 (экономит вызов и секунды).
STE_FAST_PATH=1

# Кэш исправлений и словаря. По умолчанию — внутри процесса; укажите Redis
# (redis://redis:6379/1), чтобы кэш был общим для всех воркеров gunicorn.
# CACHE_URL=

# --- optional -----------------------------------------------------------------------------
# 1 creates demo@example.com / demo-password-2026 on boot. Never set this in a real deployment.
SEED_DEMO_USER=0

# Ссылка «войти как демонстрационный пользователь» под формой входа — чтобы не набирать
# почту и пароль на каждом показе. Пусто по умолчанию: ссылки нет.
#
# Учётные данные попадают в собранный бандл и видны любому посетителю, поэтому заполнять
# можно только там же, где включён SEED_DEMO_USER=1, то есть на демонстрационном стенде.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
# 1 fills the catalogue with demo products on boot.
SEED_CATALOG=1
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

