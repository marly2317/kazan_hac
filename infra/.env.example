# Copy to infra/.env and fill in. `docker compose` reads .env from its own directory.
#
#   cp infra/.env.example infra/.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   # DJANGO_SECRET_KEY

# --- required -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- host and port ------------------------------------------------------------------------
# The port nginx publishes on the host.
PUBLIC_PORT=8080
# Every hostname the app is reached by. Django rejects requests for anything not listed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must include the scheme and the port, and must match how the browser addresses the app, or
# every POST fails CSRF validation.
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- cookies ------------------------------------------------------------------------------
# 0 for the plain-HTTP local stack; set both to 1 as soon as TLS terminates at nginx.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# --- database -----------------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app

# --- исправление опечаток: стадия LLM ----------------------------------------------------
# Правила хакатона ЗАПРЕЩАЮТ внешние API проприетарных LLM (OpenAI GPT, Google Gemini,
# Anthropic Claude «и другие подобные сервисы») и разрешают только открытые модели — суммарно
# до 40 ГБ VRAM, с предпочтением лёгким и быстрым. Роутеры LLM допускаются, предпочтительно
# отечественные (timeweb, selectel).
#
# Поэтому здесь не задан ни вендор, ни модель. Подойдёт любая OpenAI-совместимая точка входа,
# отдающая ОТКРЫТУЮ модель:
#   LLM_BASE_URL=http://vllm:8000/v1        # локальный vLLM
#   LLM_BASE_URL=http://ollama:11434/v1     # локальная Ollama
#   LLM_BASE_URL=https://<роутер>/v1        # timeweb / selectel
#   LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenRouter — ТОЛЬКО с открытой моделью
#
# ⚠️ Роутер разрешён, но модель за ним обязана быть ОТКРЫТОЙ. GPT, Gemini и Claude запрещены
# правилами независимо от того, через какой роутер к ним обращаться. Подходят, например:
#   LLM_MODEL=qwen/qwen3.7-flash                   открытая, сильна в русском, быстрая
#   LLM_MODEL=mistralai/mistral-small-24b-instruct-2501
#   LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# Правила также отдают предпочтение отечественным роутерам, так что OpenRouter — допустимый,
# но не предпочтительный вариант; на защите это стоит проговорить.
#
# Пусто = стадия выключена. Исправление продолжает работать на детерминированных стадиях
# (раскладка + словарь КТРУ), что правилами как раз поощряется.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=4.0

# Кэш исправлений и словаря. По умолчанию — внутри процесса; укажите Redis
# (redis://redis:6379/1), чтобы кэш был общим для всех воркеров gunicorn.
# CACHE_URL=

# --- optional -----------------------------------------------------------------------------
# 1 creates demo@example.com / demo-password-2026 on boot. Never set this in a real deployment.
SEED_DEMO_USER=0
# 1 fills the catalogue with demo products on boot.
SEED_CATALOG=1
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=3
